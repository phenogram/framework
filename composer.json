{
    "name": "phenogram/framework",
    "description": "True Async, strictly typed Telegram bot framework for PHP 8.6",
    "type": "library",
    "version": "7.0.0-dev",
    "license": "MIT",
    "keywords": [
        "async",
        "bot",
        "framework",
        "php",
        "telegram",
        "telegram-bot",
        "telegram-bot-api",
        "type-safe"
    ],
    "homepage": "https://github.com/phenogram/framework",
    "support": {
        "issues": "https://github.com/phenogram/framework/issues",
        "source": "https://github.com/phenogram/framework"
    },
    "autoload": {
        "psr-4": {
            "Phenogram\\Framework\\": "src",
            "Phenogram\\Framework\\Factories\\": "factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phenogram\\Framework\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Nikolai Shangin",
            "email": "shanginn@gmail.com"
        }
    ],
    "require": {
        "php": "^8.6",
        "ext-curl": "*",
        "ext-true_async": "^0.8.2",
        "psr/log": "^3.0",
        "psr-discovery/log-implementations": "^1.0",
        "psr/container": "^2.0",
        "phenogram/bindings": "^7"
    },
    "require-dev": {
        "symfony/var-dumper": "^7",
        "vlucas/phpdotenv": "^5",
        "monolog/monolog": "^3",
        "phpunit/phpunit": "^11",
        "fakerphp/faker": "^1.23"
    },
    "minimum-stability": "stable",
    "scripts": {
        "check": [
            "@composer validate --strict --no-check-version",
            "@lint:tools",
            "@style",
            "@test:offline"
        ],
        "lint:tools": "@composer --working-dir=tools/php-cs-fixer validate --strict",
        "test": "@test:offline",
        "test:offline": "php -d error_reporting=E_ALL ./vendor/bin/phpunit --configuration phpunit.xml --fail-on-warning --fail-on-deprecation",
        "test:examples": "php -d error_reporting=E_ALL ./vendor/bin/phpunit --configuration phpunit.xml --filter ReadmeExamplesTest --fail-on-warning --fail-on-deprecation",
        "test:integration": "php -d error_reporting=E_ALL ./vendor/bin/phpunit --configuration phpunit.integration.xml",
        "benchmark": "@php -n -d opcache.enable_cli=0 benchmarks/handler-fanout.php",
        "style": "./tools/php-cs-fixer/run fix --dry-run --diff --config=.php-cs-fixer.php --allow-risky=yes --sequential",
        "fix": [
            "./tools/php-cs-fixer/run fix -vvv --config=.php-cs-fixer.php --allow-risky=yes --sequential"
        ],
        "tools:install": "@composer install --working-dir=tools/php-cs-fixer --no-interaction --prefer-dist"
    }
}
